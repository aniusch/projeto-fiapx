# Copy to .env and adjust as needed. The Go services read these at startup and
# fall back to development-friendly defaults (matching docker-compose.yml) when
# a variable is unset, so this file is optional for local development.

# General
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# Gateway HTTP server
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# Postgres
POSTGRES_DSN=postgres://fiapx:fiapx@localhost:5432/fiapx?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Object storage (MinIO in dev, S3 in prod)
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fiapx-videos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Auth
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=24h

# SMTP (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@fiapx.local
