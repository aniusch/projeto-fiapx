# Copy to .env and adjust as needed. The Go services read these at startup and
# fall back to development-friendly defaults (matching docker-compose.yml) when
# a variable is unset, so this file is optional for local development.

# General
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# Gateway HTTP server
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# Postgres
POSTGRES_DSN=postgres://fiapx:fiapx@localhost:5432/fiapx?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Object storage (MinIO in dev, S3 in prod)
S3_ENDPOINT=localhost:9000
# Host that download URLs are signed for; empty = same as S3_ENDPOINT.
# In compose the gateway sets this to localhost:9000 while S3_ENDPOINT is minio:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=fiapx-videos
# Leave S3_ACCESS_KEY empty to use the AWS default credential chain (e.g. the EKS
# node role via IMDS) instead of static keys. S3_SESSION_TOKEN is for temporary
# (STS) credentials.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SESSION_TOKEN=
S3_USE_SSL=false

# Metrics endpoint for worker/notifier (gateway serves /metrics on HTTP_PORT)
METRICS_ADDR=:9101

# Auth
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=24h

# SMTP (Mailpit in dev; a real relay in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fiapx.local
SMTP_STARTTLS=false

# Worker (video processing)
FFMPEG_PATH=ffmpeg
PROCESSING_FPS=1
WORK_DIR=/tmp
JOB_TIMEOUT=10m
WORKER_CONCURRENCY=3
