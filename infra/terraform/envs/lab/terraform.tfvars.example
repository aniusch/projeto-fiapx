# Copy to terraform.tfvars and adjust. Do NOT commit terraform.tfvars.
# Prefer passing the DB password via the environment:
#   export TF_VAR_db_password='...'

region             = "us-east-1"
project            = "fiapx"
cluster_name       = "fiapx"
kubernetes_version = "1.30"
lab_role_name      = "LabRole"

node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4

db_engine_version = "16.9"
db_instance_class = "db.t3.micro"
# db_password     = "set-via-TF_VAR_db_password-instead"
