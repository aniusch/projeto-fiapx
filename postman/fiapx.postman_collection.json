{
  "info": {
    "name": "FIAP X — Video Processing API",
    "description": "End-to-end tests for the FIAP X gateway. Run the folders in order (Collection Runner or `make postman`). Requires the local stack (`make up`). File uploads read from `postman/fixtures/`; in the Postman app, set Settings → General → Working directory to the `postman/` folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness (Postgres + Redis)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/readyz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ready\", () => pm.expect(pm.response.json().status).to.eql(\"ready\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh e-mail per run so the collection is re-runnable.",
                  "pm.collectionVariables.set(\"email\", `demo+${Date.now()}@fiapx.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"returns a JWT\", () => pm.expect(token.split(\".\")).to.have.lengthOf(3));",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate e-mail → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register short password → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"short@fiapx.local\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"generic message (no user enumeration)\", () => pm.expect(pm.response.json().error).to.eql(\"invalid credentials\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Validation & security",
      "item": [
        {
          "name": "List without token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/videos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "List with bogus token → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.jwt"
              }
            ],
            "url": "{{baseUrl}}/videos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload without file → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos",
            "body": {
              "mode": "formdata",
              "formdata": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload unsupported extension → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "fixtures/notes.txt"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get with invalid id → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/not-a-uuid"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown id → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Happy path (upload → process → download)",
      "item": [
        {
          "name": "Upload video → 202 PENDING",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "fixtures/sample.mp4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "const v = pm.response.json();",
                  "pm.test(\"accepted as PENDING (async)\", () => pm.expect(v.status).to.eql(\"PENDING\"));",
                  "pm.collectionVariables.set(\"videoId\", v.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll until DONE",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/{{videoId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the worker time to pick up and process the job.",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const v = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get(\"pollDone\") || 0);",
                  "// Keep polling while the job is still PENDING/PROCESSING.",
                  "if (![\"DONE\", \"FAILED\"].includes(v.status) && tries < 40) {",
                  "  pm.collectionVariables.set(\"pollDone\", tries + 1);",
                  "  console.log(`status=${v.status}, polling again (${tries + 1}/40)`);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.unset(\"pollDone\");",
                  "pm.test(\"video reached DONE\", () => pm.expect(v.status).to.eql(\"DONE\"));",
                  "pm.test(\"has frames and a download URL\", () => {",
                  "  pm.expect(v.frame_count).to.be.above(0);",
                  "  pm.expect(v.download_url).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my videos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().videos.map(v => v.id);",
                  "pm.test(\"listing contains the uploaded video\", () => pm.expect(ids).to.include(pm.collectionVariables.get(\"videoId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download → 302 presigned URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/{{videoId}}/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 302\", () => pm.response.to.have.status(302));",
                  "const loc = pm.response.headers.get(\"Location\");",
                  "pm.test(\"redirects to a presigned object URL\", () => pm.expect(loc).to.include(\"X-Amz-Signature\"));",
                  "pm.collectionVariables.set(\"zipUrl\", loc);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Fetch the frames zip",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{zipUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is a zip file\", () => {",
                  "  const bytes = pm.response.stream;",
                  "  pm.expect(bytes[0]).to.eql(0x50); // \"P\"",
                  "  pm.expect(bytes[1]).to.eql(0x4b); // \"K\"",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Failure path (notification)",
      "item": [
        {
          "name": "Upload corrupt video → 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "fixtures/corrupt.mp4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 202\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"badVideoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll until FAILED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/{{badVideoId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the worker time to pick up and process the job.",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const v = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get(\"pollFailed\") || 0);",
                  "// Keep polling while the job is still PENDING/PROCESSING.",
                  "if (![\"DONE\", \"FAILED\"].includes(v.status) && tries < 40) {",
                  "  pm.collectionVariables.set(\"pollFailed\", tries + 1);",
                  "  console.log(`status=${v.status}, polling again (${tries + 1}/40)`);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.unset(\"pollFailed\");",
                  "pm.test(\"video reached FAILED\", () => pm.expect(v.status).to.eql(\"FAILED\"));",
                  "pm.test(\"has a user-facing error message\", () => pm.expect(v.error_message).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"no download URL for a failed video\", () => pm.expect(v.download_url).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Download failed video → 409",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/videos/{{badVideoId}}/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Failure e-mail delivered (Mailpit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpitUrl}}/api/v1/search?query=to:{{email}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000); // let the notifier consume the event"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"user got a failure e-mail\", () => pm.expect(pm.response.json().messages_count).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Isolation between users",
      "item": [
        {
          "name": "Register a second user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"otherEmail\", `other+${Date.now()}@fiapx.local`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"otherToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Other user cannot see my video → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": "{{baseUrl}}/videos/{{videoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Other user's listing is empty",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": "{{baseUrl}}/videos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no videos\", () => pm.expect(pm.response.json().videos).to.have.lengthOf(0));"
                ]
              }
            }
          ]
        }
      ]
    }
